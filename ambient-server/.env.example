# Ambient Intelligence Server Configuration
# Copy this file to .env and fill in your values.

# Server
AMBIENT_HOST=0.0.0.0
AMBIENT_PORT=8200

# WhisperFlow model (must exist in whisper-flow-main/whisperflow/models/)
WHISPER_MODEL=tiny.en.pt
WHISPER_LANGUAGE=en

# OpenAI API for LLM extraction
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Confidence thresholds
# >= AUTO_EXECUTE_THRESHOLD → action is created immediately
# >= SUGGESTION_THRESHOLD → shown as suggestion for user to approve
# < SUGGESTION_THRESHOLD → discarded
AUTO_EXECUTE_THRESHOLD=0.8
SUGGESTION_THRESHOLD=0.5

# How many seconds of transcript to accumulate before running LLM extraction
TRANSCRIPT_BUFFER_SECONDS=45

# Deduplication: don't re-extract the same item within this window (seconds)
DEDUP_WINDOW_SECONDS=300

# Undo window: how long users have to undo an auto-executed action (seconds)
# Default: 1800 (30 minutes)
UNDO_WINDOW_SECONDS=1800
